VITE_SUPABASE_ANON_KEY="sb_publishable_bUpxVfRsVPz_d0qg1QrrNA_m7zM66t6"

# RAZORPAY CONFIGURATION (India Gateway: UPI, GPay, PhonePe, Cards, NetBanking)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"
